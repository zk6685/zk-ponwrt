# 用户自定义插件集 (zk)
# —— 8 项插件主程序 + LuCI 界面 ——
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y
# 集客无线 AC 控制器 (gecoosac 核心 + LuCI 界面, laipeng668)
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_luci-app-gecoosac=y

# —— 插件依赖（make defconfig 不会自动启用 depends，必须显式 =y，否则父包被静默丢弃）——
# iStore 商店 (luci-app-store) 依赖链
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_script-utils=y
# iStoreX (luci-app-istorex) 依赖链
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-ttyd=y
# daed / daede（BPF 代理，需内核 XDP_SOCKETS + vmlinux-btf + sched-core 等全套 kmod）
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_XDP_SOCKETS_DIAG=y
CONFIG_PACKAGE_vmlinux-btf=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# Airoha NPU / SoC 状态监控（luanmuc/luci-app-airoha-npu 1.2.1，含中文汉化）
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
