# zk6685 自定义插件集（彻底重置到上游后新基线）
# 来源：small-package feed + vendored（gdy666/laipeng668/luanmuc/eamonxg）

# ============ 一、内置应用插件（=y，装进固件镜像） ============
# iStore 商店（small-package）
CONFIG_PACKAGE_luci-app-store=y
# iStoreX（small-package）
CONFIG_PACKAGE_luci-app-istorex=y
# Aurora 主题 + 配置（vendored eamonxg）
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# vlmcsd KMS 激活（small-package）
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
# zram 内存压缩（packages feed）
CONFIG_PACKAGE_zram-swap=y
# 集客无线 AC 控制器（vendored laipeng668）
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_luci-app-gecoosac=y
# Quick 网页文件管理（small-package）
CONFIG_PACKAGE_luci-app-quickfile=y
# Airoha NPU/SoC 监控（vendored luanmuc，po/ 自动生成汉化）
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
# htop（packages feed）
CONFIG_PACKAGE_htop=y

# ============ 二、依赖-only（=m 编入软件源、不装镜像，用户后期 apk add 按需安装） ============
CONFIG_PACKAGE_dae=m
CONFIG_PACKAGE_luci-app-dae=m
CONFIG_PACKAGE_luci-app-daede=m
CONFIG_PACKAGE_luci-app-openclash=m
CONFIG_PACKAGE_luci-app-passwall=m
# lucky 完整版（vendored gdy666，含 procd init + /etc/config/lucky）
CONFIG_PACKAGE_lucky=m
CONFIG_PACKAGE_luci-app-lucky=m

# ============ 三、去除内置、保留软件源供后期安装（=m） ============
CONFIG_PACKAGE_openlist=m
CONFIG_PACKAGE_luci-app-openlist=m
CONFIG_PACKAGE_zerotier=m
CONFIG_PACKAGE_luci-app-zerotier=m
CONFIG_PACKAGE_tailscale=m
CONFIG_PACKAGE_luci-app-tailscale=m
# 注：qmodem 不在当前任何配置源（small-package/immortalwrt packages 均无），后期也无法从本固件源安装，需另行加 feed

# ============ 四、关键依赖链（make defconfig 不会自动启用 depends，显式声明防父包被静默丢弃） ============
# iStore (luci-app-store) 依赖
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_script-utils=y
# iStoreX (luci-app-istorex) 依赖
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-ttyd=y
# dae/daed 关键依赖（内核 XDP/BTF =y 编进内核；dae 依赖的 kmod-sched-core/sched-bpf/veth/xdp 全部 =y 烧进固件镜像，装 dae 即用；vmlinux-btf/ca-bundle =m 供后期装）
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_XDP_SOCKETS_DIAG=y
CONFIG_PACKAGE_vmlinux-btf=m
CONFIG_PACKAGE_ca-bundle=m
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# ============ 五、覆盖上游内置（修复 -9 编译失败） ============
# release.config 内置 CONFIG_PACKAGE_luci-app-upnp=y，其强制依赖 miniupnpd（默认 nftables variant）编译失败，禁用以移除
CONFIG_PACKAGE_luci-app-upnp=n

# ============ 六、DAE 运行前提（QiuSimons/luci-app-daed 官方内核配置，精确设置） ============
CONFIG_DEVEL=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y

